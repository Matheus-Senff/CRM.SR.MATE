# Supabase (Project Settings → API). A URL do projeto já está preenchida.
NEXT_PUBLIC_SUPABASE_URL=https://ftqccptcnknyyyukojvo.supabase.co
# Se o projeto foi ligado pela integração Vercel ↔ Supabase, as variáveis
# NEXT_PUBLIC_SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY criadas por ela
# também funcionam no lugar das duas chaves abaixo.
# Chave pública: "Publishable key" (sb_publishable_...) ou a "anon key" antiga.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta, só no servidor: "Secret key" (sb_secret_...) ou a "service_role" antiga.
# Usada para gravar os tokens do Bling, sincronizar produtos e registrar pedidos.
SUPABASE_SECRET_KEY=

# Bling API v3 (Central de Extensões → Área do integrador → seu aplicativo).
# No cadastro do aplicativo, a URL de redirecionamento deve ser
# https://SEU-DOMINIO/api/bling/callback
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Segredo que a Vercel envia no cron de sincronização (Authorization: Bearer ...).
CRON_SECRET=
